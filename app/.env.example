# Copy to .env.local (NEVER commit real secrets — .env* is gitignored)
DATABASE_URL="postgresql://ideacon:ideacon_local_dev@localhost:5432/ideacon"

BETTER_AUTH_SECRET="change-me-32-chars-minimum"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (optional in Phase 0)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare R2 (Phase 1 file uploads; Phase 0 code-ready only)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="ideacon-private"

# ZeptoMail (Zoho) transactional email — console-logs when unset.
# Token: ZeptoMail dashboard → Mail Agent → Send Mail Token.
# Sender domain must be verified in Zoho; keep this placeholder value here
# (committed fallbacks must never equal production values).
ZEPTOMAIL_TOKEN=""
EMAIL_FROM="IDEACON <dev@localhost>"

# Gmail SMTP fallback (no domain needed — pilot-friendly, 500/day).
# App password: Google Account → Security → 2-Step Verification → App passwords.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# PostHog analytics (optional; analytics no-ops when unset)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Groq LLM scoring (falls back to heuristic when unset)
GROQ_API_KEY=""
# Production uses openai/gpt-oss-120b; example keeps a different default
# so committed placeholders never match production values.
GROQ_MODEL="qwen/qwen3.8-27b"

# Paystack (test mode first — NEVER commit real keys; .env.local only)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Webhook URL to paste in Paystack dashboard:
# https://<your-domain>/api/paystack/webhook
